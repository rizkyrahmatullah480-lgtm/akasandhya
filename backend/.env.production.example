APP_NAME=Invitaku
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.domainanda.com
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Supabase (PostgreSQL) ---
# Ambil dari Supabase Dashboard > Project Settings > Database > Connection string.
# PENTING: gunakan port 5432 (session mode/direct), BUKAN 6543 (transaction
# pooler) karena fitur check-in memakai transaksi + lockForUpdate.
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.xxxxxxxxxxxx
DB_PASSWORD=ganti_password_kuat
DB_SSLMODE=require

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# --- Frontend / CORS ---
# Ganti dengan URL frontend production (misal https://invitaku.netlify.app)
FRONTEND_URL=https://domain-frontend-anda.com
CORS_ALLOWED_ORIGINS=https://domain-frontend-anda.com

# --- WhatsApp Business Cloud API (optional) ---
WHATSAPP_API_ENABLED=false
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=ganti-token-rahasia

# WHATSAPP_MESSAGE_TEMPLATE=

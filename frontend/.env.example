# URL of the Laravel API (must include /api).
# Defaults to http://127.0.0.1:8000/api when this file is absent (local XAMPP).
PUBLIC_API_URL=http://127.0.0.1:8000/api

# PENTING untuk Vercel/hosting statis:
# Jangan biarkan nilai localhost. Di Vercel, buka
# Project -> Settings -> Environment Variables, lalu tambahkan:
#   PUBLIC_API_URL = https://domain-backend-anda.com/api
# Setelah itu redeploy. Karena adapter yang dipakai adalah adapter-static,
# variabel PUBLIC_* disematkan saat build.
# Backend juga harus sudah online & mendukung HTTPS/CORS.
